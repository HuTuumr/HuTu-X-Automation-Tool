{
  "manifest_version": 3,
  "name": "HuTu助手",
  "version": "0.7.4",
  "description": "用本地模型（LM Studio / Ollama）为 X 时间线生成回复草稿，人工确认后发送。",
  "permissions": ["storage", "alarms", "clipboardWrite"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "HuTu助手",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["panel.css"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ]
}
